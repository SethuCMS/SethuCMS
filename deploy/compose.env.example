# Copy to /opt/sethucms/.env on the server and fill in. Never commit the real file.
# Make each secret with:  openssl rand -base64 32
SETHUCMS_IMAGE=ghcr.io/sethucms/sethucms:0.1.0
POSTGRES_PASSWORD=
SETHUCMS_DOMAIN=cms.example.com
SETHUCMS_VAULT_KEY=
SETHUCMS_CURSOR_SECRET=
SETHUCMS_PREVIEW_SECRET=
SETHUCMS_ADMIN_TOKEN=
# Use off if you run the separate worker (--profile worker)
SETHUCMS_WORKER=on
# Caddy is in front of the gateway: trust its forwarded client address (rate limits need this).
SETHUCMS_TRUST_PROXY=true
# Single sign-on (optional, see docs/21-sso.md)
# SETHUCMS_PUBLIC_URL=https://cms.example.com
# SETHUCMS_OIDC_ISSUER=
# SETHUCMS_OIDC_CLIENT_ID=
# SETHUCMS_OIDC_CLIENT_SECRET=
# SETHUCMS_OIDC_ADMIN_VALUES=
