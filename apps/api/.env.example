# Settings for the SethuCMS gateway. Copy to .env and export, or set in your process manager.
# Everything has a safe default for local use. In production the secrets below are required.

# --- Where it listens --------------------------------------------------------
PORT=8080
# Default is 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.
# HOST=127.0.0.1

# --- Production mode ---------------------------------------------------------
# NODE_ENV=production
#  - requires the three secrets below and SETHUCMS_ADMIN_TOKEN
#  - turns off the demo connection and private-network access unless you ask for them

# --- Secrets (create each with:  openssl rand -base64 32) ---------------------
# Locally these are generated into <data dir>/secrets.json on first start.
# SETHUCMS_VAULT_KEY=        encrypts saved database passwords and drafts
# SETHUCMS_CURSOR_SECRET=    signs pagination cursors
# SETHUCMS_PREVIEW_SECRET=   signs preview links

# --- First admin ---------------------------------------------------------------
# Your own admin token (32 to 200 characters: A-Z a-z 0-9 _ - .). Create one with:  openssl rand -hex 32
# If you leave this out locally, one is generated and printed once on first start.
# SETHUCMS_ADMIN_TOKEN=

# --- Storage -------------------------------------------------------------------
# Folder for saved connections, drafts, tokens and the audit log. "memory" keeps nothing on disk.
SETHUCMS_DATA_DIR=./.sethucms-data

# Folder where SQLite connections may keep their files (needs Node 22.5+). Unset = SQLite files disabled; ":memory:" always works.
# SETHUCMS_SQLITE_DIR=./.sethucms-data/sqlite
# Start even though another gateway seems to hold the data folder lock. Recovery only: two gateways on one folder corrupt it.
# SETHUCMS_FORCE_LOCK=1

# --- Admin app -----------------------------------------------------------------
# Folder with the built admin app (sethucms-admin/dist). When set, the gateway serves it at /.
# SETHUCMS_ADMIN_DIR=../../../sethucms-admin/dist
# Browser origins allowed to call the API from another address (comma separated).
# SETHUCMS_ALLOWED_ORIGINS=http://localhost:5173

# --- Networking ----------------------------------------------------------------
# Let connections reach databases on private networks (10.x, 192.168.x, 127.x ...).
# Default: on locally, off in production. The cloud metadata address stays blocked either way.
# SETHUCMS_ALLOW_PRIVATE_NETWORKS=true
# Believe X-Forwarded-For. Turn on only behind a proxy you control.
# SETHUCMS_TRUST_PROXY=false

# --- Demo data -----------------------------------------------------------------
# Add a "Demo content" connection with sample articles on first start. Default: on locally, off in production.
# SETHUCMS_SEED_DEMO=true

# --- Logging and monitoring ---------------------------------------------------
# Lowest level written to the log: debug, info, warn, error. Default: info.
# SETHUCMS_LOG_LEVEL=info
# json = one object per line (log tools), pretty = readable. Default: pretty at a terminal outside production, else json.
# SETHUCMS_LOG_FORMAT=json
# Requests slower than this many milliseconds are logged as warnings. Default: 1000.
# SETHUCMS_SLOW_REQUEST_MS=1000
# Rotate the audit log at this size (MB) and keep this many old files. Defaults: 10 and 5.
# SETHUCMS_AUDIT_MAX_MB=10
# SETHUCMS_AUDIT_KEEP=5
# Lets a monitoring tool read /v1/metrics without an admin token. 32-200 chars (openssl rand -hex 32).
# SETHUCMS_METRICS_TOKEN=

# --- Several gateways (shared state) -------------------------------------------
# PostgreSQL address. When set, gateways share state, audit log, idempotency keys, events and the change feed.
# Secrets must then come from the environment. Use SETHUCMS_DATA_DIR=memory if the host has no disk.
# SETHUCMS_STATE_URL=postgres://user:password@host:5432/sethucms
# How often (ms) a gateway checks for changes it was not told about. Default: 1000.
# SETHUCMS_STATE_POLL_MS=1000

# --- Webhook worker -------------------------------------------------------------
# on (default) = each gateway sends webhooks itself. off = run `node dist/src/worker.js` separately.
# SETHUCMS_WORKER=on

# --- Single sign-on (OpenID Connect), see doc 21 --------------------------------
# SETHUCMS_OIDC_ISSUER=https://login.example.com
# SETHUCMS_PUBLIC_URL=https://cms.example.com
# SETHUCMS_OIDC_CLIENT_ID=
# SETHUCMS_OIDC_CLIENT_SECRET=
# SETHUCMS_OIDC_SCOPES=openid profile email
# SETHUCMS_OIDC_ROLE_CLAIM=groups
# SETHUCMS_OIDC_ADMIN_VALUES=cms-admins
# SETHUCMS_OIDC_EDITOR_VALUES=cms-editors
# SETHUCMS_OIDC_VIEWER_VALUES=cms-viewers
# editor or viewer only; leave empty to refuse people with no matching group
# SETHUCMS_OIDC_DEFAULT_ROLE=
# SETHUCMS_OIDC_ALLOWED_DOMAINS=example.com
# SETHUCMS_OIDC_SESSION_HOURS=8
# SETHUCMS_ADMIN_URL=https://cms.example.com
