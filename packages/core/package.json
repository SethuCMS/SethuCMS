{
  "name": "@sethucms/core",
  "version": "0.1.0",
  "description": "Core types, content model, portable query AST, capabilities, permissions and errors for SethuCMS",
  "author": "Kasinadh Sarma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SethuCMS/SethuCMS.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SethuCMS/SethuCMS#readme",
  "bugs": {
    "url": "https://github.com/SethuCMS/SethuCMS/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
